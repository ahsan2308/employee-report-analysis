{
  "beat_schedule": {
    "sync-incremental-weekly": {
      "options": "{'queue': 'sync'}",
      "schedule": "<crontab: 0 2 * * 1 (m/h/dM/MY/d)>",
      "task": "sync.incremental"
    }
  },
  "main": "employee_report_analysis",
  "task_routes": {
    "app.tasks.analysis_tasks.*": {
      "queue": "analysis"
    },
    "app.tasks.import_tasks.*": {
      "queue": "imports"
    },
    "csv_import.process": {
      "queue": "imports"
    },
    "sync.*": {
      "queue": "sync"
    }
  }
}
