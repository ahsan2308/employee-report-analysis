    "DB_USER": "myuser"
  },
  "app.database.postgres_database": {},
  "app.model_host": {
    "EMBEDDING_PROVIDER": "ollama",
    "EMBEDDING_USE_PREFIX": false,
    "LLM_PROVIDER": "ollama",
