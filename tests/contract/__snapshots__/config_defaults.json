    "VLLM_EMBEDDING_API_KEY": null,
    "VLLM_EMBEDDING_BASE_URL": "http://localhost:8001",
    "VLLM_EMBEDDING_MODEL": "BAAI/bge-m3",
    "VLLM_MODEL": "meta-llama/Meta-Llama-3.1-8B-Instruct"
  },
  "app.models.base": {},
  "app.services.llm_service": {
    "DEFAULT_MODEL": "llama3.1:8b",
    "LLM_PROVIDER": "ollama"
  },
  "app.services.vector_store_service": {
    "COLLECTION_NAME": "employee_reports",
    "VECTOR_BATCH_MAX_RETRIES": 3,
    "VECTOR_BATCH_MODE": true,
    "VECTOR_EMBEDDING_BATCH_SIZE": 50,
    "VECTOR_UPSERT_BATCH_SIZE": 100
  },
  "app.tasks.analysis_tasks": {
    "MAX_CONTENT_ITEMS_PER_ENTITY_FOR_MONTHLY_ANALYSIS": 10,
    "MAX_CONTENT_ITEMS_PER_ENTITY_FOR_QUARTERLY_ANALYSIS": 10,
    "MAX_CONTENT_ITEMS_PER_ENTITY_FOR_WEEKLY_ANALYSIS": 10,
    "MAX_CONTENT_ITEM_LENGTH_MONTHLY": 250,
    "MAX_CONTENT_ITEM_LENGTH_QUARTERLY": 200,
    "MAX_CONTENT_ITEM_LENGTH_WEEKLY": 300,
    "VECTOR_SEARCH_HNSW_EF": 128
  },
  "app.vector_store": {
    "VECTOR_STORE_HOST": "localhost",
    "VECTOR_STORE_MODE": "local",
    "VECTOR_STORE_PATH": "./qdrant_data",
    "VECTOR_STORE_PORT": 6333,
    "VECTOR_STORE_TYPE": "qdrant"
  },
  "app.worker.celery_app": {
    "IS_WINDOWS": false,
    "REDIS_HOST": "localhost",
    "SYNC_ENABLED": true
  },
  "celery": {
    "beat_schedule": {
      "sync-incremental-weekly": {
        "options": "{'queue': 'sync'}",
        "schedule": "<crontab: 0 2 * * 1 (m/h/dM/MY/d)>",
        "task": "sync.incremental"
      }
    },
    "broker_url": "redis://localhost:6379/0",
    "result_backend": "redis://localhost:6379/0",
    "settings": {
      "accept_content": [
        "json"
      ],
      "result_expires": 86400,
      "result_serializer": "json",
      "task_ignore_result": false,
      "task_serializer": "json",
      "task_time_limit": 300,
      "task_track_started": true,
      "worker_concurrency": 2
    },
    "task_packages": [
      "app.tasks"
    ]
  },
  "config_provider": {
    "None:database": {
      "host": "localhost",
      "name": "employee_reports",
      "password": "mypassword",
      "port": 5432,
      "url": "postgresql://myuser:mypassword@localhost:5432/employee_reports",
      "user": "myuser"
    },
    "llm:model": "llama3.1:8b",
    "no.such.section:missing_key": "fallback",
    "redis:host": "localhost",
    "redis:port": 6379,
    "vector_db.batch_processing.retry:max_attempts": 3,
    "vector_db.batch_processing:enabled": true,
    "vector_db.search:hnsw_ef": 128,
    "vector_db:collection_name": "employee_reports",
    "vector_db:host": "localhost",
    "vector_db:missing_key": "fallback",
    "vector_db:mode": "local",
    "vector_db:port": 6333,
    "vector_db:type": "qdrant"
  },
  "get_database": {
    "class": "PostgresDatabase",
    "schema_name": "public",
    "url": "postgresql://myuser:mypassword@localhost:5432/employee_reports"
  }
