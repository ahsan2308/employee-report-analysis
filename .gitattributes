# Ensure consistent line endings
* text=auto

# Scripts and code should use LF (Unix-style)
*.py   text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf

# Windows-specific scripts can keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Test fixture data must stay byte-exact (CRLF, BOMs, legacy encodings)
tests/**/data/** -text
